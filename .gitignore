# Secretos / configuración local
.env

# Entorno virtual
.venv/
venv/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# Tests / cache
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# Editor
.vscode/
.idea/

# Contexto local para Claude Code -- no forma parte del entregable
CLAUDE.md
CLAUDE_CHANGELOG.md

# Salidas generadas por Miner (opcional, evita subir CSV grandes por accidente)
*.csv
!examples/*.csv

# Dataset generado por 'miner extract' (se publica en Hugging Face, no en git)
/dataset/
*.parquet

# Checkpoints de progreso interno (mine y extract) -- no son parte del
# dataset ni del código, solo estado temporal para poder reanudar
*.checkpoint.jsonl